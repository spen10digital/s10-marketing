# LOCAL DEVELOPMENT ONLY - names only, never commit values. Copy to apps/web/.env.local.
# In AWS, config comes from SSM Parameter Store and Secrets Manager (see docs/05 section 5 and docs/config-inventory.md).
APP_ENV=local
# Local dev runs on port 3010 (the Suite's dev sign-in client allows http://localhost:3010)
APP_URL=http://localhost:3010
LOG_LEVEL=info
AWS_PROFILE=
# Vercel only (not secret): IAM role assumed via Vercel OIDC. Leave empty locally to use AWS_PROFILE.
AWS_ROLE_ARN=
AWS_REGION=us-east-2
# App connection, as app_rw (password = LOCAL_APP_RW_PASSWORD, set by pnpm db:migrate), e.g.
# postgres://app_rw:<password>@localhost:5432/s10_marketing
DATABASE_URL=
# Superuser for pnpm db:migrate / pnpm test:db only (default: the docker-compose postgres user)
DATABASE_ADMIN_URL=
LOCAL_APP_RW_PASSWORD=
# Sign-in goes through S10/Suite's shared Cognito pool with this app's own client (created by the Suite owner).
# Dev: pool s10-suite-dev-users, Suite https://suite-dev.spen10.com. Prod: Suite https://suite.spen10.com, domain login.spen10.com.
SUITE_URL=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
# This app's registry id (default marketing)
S10_APP_ID=marketing
# SECRET, environment only (never Parameter Store, never committed). 32 random bytes, base64url, different per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SUITE_SESSION_SECRET=
META_APP_ID=
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v26.0
AI_MODEL_GENERATE=
AI_MODEL_FAST=
AI_DEFAULT_MONTHLY_BUDGET_USD=
# bedrock (default, uses AWS_PROFILE) or fake (canned answers, no AWS; local only)
AI_PROVIDER=
PUBLISHING_ENABLED=false
AUTOMATION_ENABLED=false
