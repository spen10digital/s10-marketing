{
  "name": "s10-marketing",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @s10/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project infra",
    "test:db": "vitest run --project db --passWithNoTests --no-file-parallelism",
    "test:e2e": "pnpm --filter @s10/web test:e2e",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:verify-context": "tsx scripts/verify-data-api-context.ts",
    "infra:synth": "pnpm --filter @s10/infra synth",
    "infra:diff": "pnpm --filter @s10/infra diff",
    "eval:ai": "tsx scripts/eval-ai.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1161.0",
    "@aws-sdk/client-rds-data": "^3.1161.0",
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "@aws-sdk/client-ssm": "^3.1161.0",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.4.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "pg": "^8.23.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
